<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" lang="{{ meta.language }}" xml:lang="{{ meta.language }}">
<head>
  <meta charset="UTF-8"/>
  <title>{{ title }}</title>
  <link rel="stylesheet" type="text/css" href="{{ stylesheet }}"/>
</head>
<body>
{%- macro pagebreak(node) -%}
<span epub:type="pagebreak" role="doc-pagebreak" id="{{ node.id }}" aria-label="{{ node.label }}"></span>
{%- endmacro %}
{%- macro inlines(items) -%}
{%- for node in items -%}
{%- if node.kind == "pagebreak" -%}{{ pagebreak(node) }}
{%- else -%}
{%- if node.bold %}<b>{% endif %}{% if node.italic %}<i>{% endif -%}
{{ node.text }}
{%- if node.italic %}</i>{% endif %}{% if node.bold %}</b>{% endif -%}
{%- endif -%}
{%- endfor -%}
{%- endmacro %}
{%- for node in blocks %}
{%- if node.kind == "pagebreak" %}
  {{ pagebreak(node) }}
{%- elif node.kind == "heading" %}
  <h{{ node.level }} id="{{ node.id }}">{{ inlines(node.inlines) }}</h{{ node.level }}>
{%- elif node.kind == "page_image" %}
  <figure class="page-image">
    <img src="{{ node.src }}" alt="{{ node.alt }}"/>
    {%- if node.text %}
    <div class="hidden-text">{{ node.text }}</div>
    {%- endif %}
  </figure>
{%- elif node.kind == "lines" and node.monospace %}
  <p class="lines code"><code>
  {%- for line in node.lines %}{% if not loop.first %}<br/>{% endif %}{{ inlines(line) }}{% endfor -%}
  </code></p>
{%- elif node.kind == "lines" %}
  <p class="lines">
  {%- for line in node.lines %}{% if not loop.first %}<br/>{% endif %}{{ inlines(line) }}{% endfor -%}
  </p>
{%- else %}
  <p>{{ inlines(node.inlines) }}</p>
{%- endif %}
{%- endfor %}
</body>
</html>
